{
  "name": "leaklens",
  "version": "0.1.0",
  "description": "Scan repositories, working trees and git history for leaked secrets, API keys and credentials.",
  "license": "MIT",
  "author": "Chimaobi Dennis <igsoftwebstudio@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/chimaobi-dennis/founder-foundry-engine"
  },
  "keywords": ["security", "secrets", "secret-scanning", "credentials", "git", "sarif", "devsecops"],
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "leaklens": "./dist/cli/index.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "scan": "tsx src/cli/index.ts scan . --history",
    "scan:self": "tsx src/cli/index.ts scan . --history --format pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
